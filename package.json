{
  "name": "milk-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Family milk business financial record manager",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "seed:clear": "npm run seed:clear -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
